{
  "name": "johnhenry/craft-clicky-analytics",
  "description": "Clicky analytics in the Craft control panel: dashboard widgets, a live visitor feed and a Page Stats field for each entry.",
  "type": "craft-plugin",
  "version": "1.2.0",
  "keywords": [
    "clicky",
    "clicky analytics",
    "web analytics",
    "visitor statistics",
    "live visitors",
    "dashboard widgets",
    "page stats",
    "page views",
    "traffic sources",
    "analytics dashboard"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "John Henry",
      "homepage": "https://johnhenry.ie"
    }
  ],
  "homepage": "https://github.com/john-henry/craft-clicky-analytics",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "craftcms/cms": "^5.0 || ^6.0.0-beta.1"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.2"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "johnhenry\\clickyanalytics\\": "src/"
    }
  },
  "scripts": {
    "phpstan": "phpstan --ansi --memory-limit=1G",
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --fix --ansi"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "support": {
    "docs": "https://johnhenry.ie/plugins/clicky-analytics/",
    "source": "https://github.com/john-henry/craft-clicky-analytics",
    "issues": "https://github.com/john-henry/craft-clicky-analytics/issues"
  },
  "extra": {
    "name": "Clicky Analytics",
    "handle": "clicky-analytics",
    "developer": "John Henry",
    "developerUrl": "https://johnhenry.ie",
    "documentationUrl": "https://johnhenry.ie/plugins/clicky-analytics/",
    "changelogUrl": "https://github.com/john-henry/craft-clicky-analytics/blob/craft-5/CHANGELOG.md",
    "class": "johnhenry\\clickyanalytics\\ClickyAnalytics"
  }
}
