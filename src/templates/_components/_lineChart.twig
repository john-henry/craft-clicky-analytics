{# ============================================================================
 # Line chart
 # An SVG area + line chart from a [{date, value}] series.
 # Props: series
 # ========================================================================== #}
{% if series is empty %}
    <p class="clicky-muted">{{ 'No data for this period.'|t('clicky-analytics') }}</p>
{% else %}
    {% set w = 1000 %}{% set h = 300 %}
    {% set padL = 38 %}{% set padR = 12 %}{% set padT = 12 %}{% set padB = 28 %}
    {% set plotW = w - padL - padR %}
    {% set plotH = h - padT - padB %}
    {% set baseY = padT + plotH %}
    {% set n = series|length %}
    {% set max = 1 %}
    {% for p in series %}{% set max = max(max, p.value|default(0)) %}{% endfor %}

    {% set pts = [] %}
    {% for p in series %}
        {% set x = n > 1 ? padL + (loop.index0 / (n - 1) * plotW) : padL + plotW / 2 %}
        {% set y = padT + plotH * (1 - (p.value|default(0) / max)) %}
        {% set pts = pts|merge([{ x: x|round(1), y: y|round(1), v: p.value|default(0), d: p.date }]) %}
    {% endfor %}

    {% set line = '' %}
    {% set areaMid = '' %}
    {% for pt in pts %}
        {% set line = line ~ (loop.first ? 'M' : 'L') ~ pt.x ~ ' ' ~ pt.y ~ ' ' %}
        {% set areaMid = areaMid ~ 'L' ~ pt.x ~ ' ' ~ pt.y ~ ' ' %}
    {% endfor %}
    {% set area = 'M' ~ (pts|first).x ~ ' ' ~ baseY ~ ' ' ~ areaMid ~ 'L' ~ (pts|last).x ~ ' ' ~ baseY ~ ' Z' %}

    {% set step = (n / 8)|round(0, 'ceil') %}
    {% set step = step < 1 ? 1 : step %}

    <svg class="clicky-chart" viewBox="0 0 {{ w }} {{ h }}" role="img" aria-label="{{ 'Visitors over time'|t('clicky-analytics') }}">
        <defs>
            <linearGradient id="clicky-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--clicky-soft, var(--clicky-accent))" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="var(--clicky-soft, var(--clicky-accent))" stop-opacity="0"/>
            </linearGradient>
        </defs>
        {% for g in 0..4 %}
            {% set gy = (padT + plotH * (g / 4))|round(1) %}
            <line class="clicky-chart__grid" x1="{{ padL }}" y1="{{ gy }}" x2="{{ w - padR }}" y2="{{ gy }}"/>
            <text class="clicky-chart__ylabel" x="{{ padL - 8 }}" y="{{ gy + 4 }}">{{ (max * (1 - g / 4))|round }}</text>
        {% endfor %}
        <path d="{{ area }}" fill="url(#clicky-area)"/>
        <path d="{{ line }}" class="clicky-chart__line"/>
        {% for pt in pts %}
            <circle class="clicky-chart__dot" cx="{{ pt.x }}" cy="{{ pt.y }}" r="3.5"><title>{{ pt.d }}: {{ pt.v|number }}</title></circle>
        {% endfor %}
        {% for pt in pts %}
            {% if loop.index0 % step == 0 or loop.last %}
                <text class="clicky-chart__xlabel" x="{{ pt.x }}" y="{{ h - 9 }}" text-anchor="middle">{{ pt.d|date('j M') }}</text>
            {% endif %}
        {% endfor %}
    </svg>
{% endif %}
