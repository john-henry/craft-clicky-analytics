{# Shared ranked-list widget body (top pages / sources / countries / browsers). #}
<div class="clicky-widget {{ clickyUiClass|default('') }}">
    {% include 'clicky-analytics/_components/_rankedList' with {
        rows: rows,
        accent: accent,
        drilldown: drilldown|default(false),
        date: date|default(''),
    } only %}
</div>
