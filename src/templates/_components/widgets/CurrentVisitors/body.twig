{# Current Visitors widget body. #}
<div class="clicky-widget clicky-now {{ clickyUiClass|default('') }}">
    <span class="clicky-now__dot"></span>
    <span class="clicky-now__value">{{ visitorsOnline|number }}</span>
    <span class="clicky-now__label">{{ 'visitors online now'|t('clicky-analytics') }}</span>
</div>
