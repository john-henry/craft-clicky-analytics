{# ============================================================================
 # Icon
 # Renders one of the plugin's inline SVG icons by `name`. Used by the
 # dashboard and widget body templates wherever a stat card, ranked list row
 # or trend indicator needs a small inline glyph.
 # ========================================================================== #}
{%- set strokeAttrs = 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"' -%}
{%- if name == 'document' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
{%- elseif name == 'globe' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 2.6 15.4 0 18M12 3c-2.6 2.6-2.6 15.4 0 18"/></svg>
{%- elseif name == 'map' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M9 3 4 5v16l5-2 6 2 5-2V3l-5 2-6-2Z"/><path d="M9 3v16M15 5v16"/></svg>
{%- elseif name == 'window' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18M6.5 7h.01M9.5 7h.01"/></svg>
{%- elseif name == 'desktop' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
{%- elseif name == 'search' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
{%- elseif name == 'phone' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/></svg>
{%- elseif name == 'tablet' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M11 18h2"/></svg>
{%- elseif name == 'device' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="4" y="4" width="16" height="13" rx="2"/><path d="M2 21h20"/></svg>
{%- elseif name == 'download' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
{%- elseif name == 'target' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6"/></svg>
{%- elseif name == 'megaphone' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M3 11v2a1 1 0 0 0 1 1h2l9 5V5L6 10H4a1 1 0 0 0-1 1Z"/><path d="M19 9a4 4 0 0 1 0 6"/></svg>
{%- elseif name == 'external' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M14 4h6v6M20 4l-9 9M19 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/></svg>
{%- elseif name == 'chevron' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="m6 9 6 6 6-6"/></svg>
{%- elseif name == 'monitor' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
{%- elseif name == 'pin' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M12 21s-6-5.3-6-10a6 6 0 1 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2.2"/></svg>
{%- elseif name == 'eye' -%}
    <svg class="clicky-icon" viewBox="0 0 24 24" {{ strokeAttrs|raw }}><path d="M2.5 12S5.5 5.5 12 5.5 21.5 12 21.5 12 18.5 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/></svg>
{%- elseif name == 'arrow-up' -%}
    <svg class="clicky-trend__arrow" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 6l6 8H6z"/></svg>
{%- elseif name == 'arrow-down' -%}
    <svg class="clicky-trend__arrow" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 18l-6-8h12z"/></svg>
{%- endif -%}
